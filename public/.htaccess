# Hostinger Node.js Proxy — fixes 403 on /api/admin/* paths
# Place this file in the web root (public_html or the domain root on Hostinger)

Options -MultiViews -Indexes
RewriteEngine On

# Ensure Authorization header is passed to Node.js (some Apache configs strip it)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Allow all common HTTP methods (fixes 403 on PUT/DELETE/PATCH)
<LimitExcept GET POST OPTIONS PUT DELETE PATCH>
    Order allow,deny
    Allow from all
</LimitExcept>

# Handle Preflight OPTIONS requests directly in Apache (optional but helpful)
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Allow direct access to existing static files & directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Proxy all other requests to our Node.js server
RewriteRule ^(.*)$ http://localhost:8000/$1 [P,L,QSA]

# CORS & CSP — permissive headers (fallback if Node.js headers don't arrive)
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https:; font-src 'self' https://fonts.gstatic.com https: data:; img-src 'self' https: data: blob:; connect-src 'self' https: wss:; worker-src 'self' blob:;"
  Header always unset X-Powered-By
</IfModule>
